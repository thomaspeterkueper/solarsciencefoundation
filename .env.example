NEXT_PUBLIC_SUPABASE_URL=https://eiwudquwkymshqdskjxm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-publishable-or-anon-key

# Server only. Never expose this in client code and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Preferred KG integration. When set, SSF tries the KG Live API first and falls back to public exports.
KUEPER_KG_API_URL=https://replace-with-kg-live-api.example

# Optional Knowledge Graph export overrides. Defaults use the KG adapter and public Knowledge Graph exports.
KUEPER_KG_KXF_URL=exports/kxf-0.1.json
KUEPER_KXF_MODULES_URL=exports/kxf-learning-modules-0.1.json
KUEPER_KG_KNOWLEDGE_DOMAINS_URL=exports/knowledge-domains-0.1.json

# SSF Research Watch (docs/RESEARCH-WATCH.md). Cron /api/cron/research-watch.
# Dry-run by default: the full pipeline runs on an in-memory store, nothing persists.
# Set to "false" to persist evidence/candidates via the Supabase service role
# (requires migration 20260824120000_research_watch.sql).
RESEARCH_WATCH_DRY_RUN=true

# Only where a writable checkout exists (local dev): directory for cross-project
# KUEPER outbox envelopes (.kueper/outbox) emitted for KG-directed CANON_VALIDATION
# candidates. Leave unset on Vercel — candidates stay in the store.
# RESEARCH_WATCH_OUTBOX_DIR=.kueper/outbox

# Optional feed URLs for the disabled network sources in config/research-watch/sources.json.
# RESEARCH_WATCH_ARXIV_FEED_URL=https://feed.example/arxiv-bridge.json
# RESEARCH_WATCH_AGENCY_FEED_URL=https://feed.example/agency-releases.json
